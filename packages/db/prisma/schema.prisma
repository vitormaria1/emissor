generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas  = ["app"]
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@schema("app")
}

enum FocusEnvironment {
  HOMOLOGATION
  PRODUCTION

  @@schema("app")
}

enum InvoiceStatus {
  DRAFT
  QUEUED
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCEL_REQUESTED
  CANCELED

  @@schema("app")
}

model User {
  id             String    @id @default(uuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships    CompanyMember[]
  sessions       Session[]
  accounts       Account[]
  invoicesCreated Invoice[] @relation("InvoiceCreatedBy")

  @@index([createdAt])
  @@schema("app")
}

// Auth.js (NextAuth) adapter models
model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@schema("app")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("app")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("app")
}

model Company {
  id                 String             @id @default(uuid())
  name               String
  cnpj               String             @unique
  municipalInscription String?
  taxRegime          String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  fiscalConfiguration FiscalConfiguration?
  members            CompanyMember[]
  customers          Customer[]
  services           Service[]
  invoices           Invoice[]

  @@index([createdAt])
  @@schema("app")
}

model CompanyMember {
  id        String          @id @default(uuid())
  companyId String
  userId    String
  role      MembershipRole  @default(MEMBER)
  createdAt DateTime        @default(now())

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@schema("app")
}

model FiscalConfiguration {
  id             String           @id @default(uuid())
  companyId      String           @unique
  focusEnvironment FocusEnvironment @default(HOMOLOGATION)
  focusTokenHomologation String?
  focusTokenProduction   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@schema("app")
}

model Customer {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  email       String?
  document    String?  // CPF/CNPJ
  phone       String?
  addressJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices    Invoice[]

  @@index([companyId, createdAt])
  @@schema("app")
}

model Service {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  serviceCode String?  // código do serviço (LC 116 / municipal)
  cnae        String?
  municipalTaxCode String? // item lista serviço municipal, quando aplicável
  unitPrice   Decimal  @db.Decimal(14, 2)
  issRate     Decimal? @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       InvoiceItem[]

  @@index([companyId, createdAt])
  @@schema("app")
}

model Invoice {
  id              String        @id @default(uuid())
  companyId        String
  createdByUserId  String?
  customerId       String?
  reference        String        @unique // nossa referência (também usada na Focus)
  status           InvoiceStatus @default(DRAFT)
  focusEnvironment FocusEnvironment @default(HOMOLOGATION)
  issueDate        DateTime?
  totalAmount      Decimal       @db.Decimal(14, 2)
  notes            String?

  focusRequestPayload Json?
  focusResponse      Json?
  focusLastStatus    String?
  focusProtocol      String?
  focusPdfUrl        String?
  focusXmlUrl        String?

  authorizedAt     DateTime?
  canceledAt       DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy        User?    @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@schema("app")
}

model InvoiceItem {
  id         String   @id @default(uuid())
  invoiceId  String
  serviceId  String?
  description String?
  quantity   Decimal  @db.Decimal(14, 4)
  unitPrice  Decimal  @db.Decimal(14, 2)
  amount     Decimal  @db.Decimal(14, 2)
  issRate    Decimal? @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@schema("app")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  companyId   String?
  provider    String   // "focus"
  eventType   String
  reference   String?
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  status      String   @default("RECEIVED")

  @@index([provider, receivedAt])
  @@index([reference])
  @@schema("app")
}
