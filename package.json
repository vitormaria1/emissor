{
  "name": "emissor-nf",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma SaaS de emissão de NFS-e (Focus NFe)",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build && node scripts/vercel-next-output.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier -w .",
    "db:migrate": "npm -w @emissor/db run prisma:migrate",
    "db:studio": "npm -w @emissor/db run prisma:studio",
    "db:generate": "npm -w @emissor/db run prisma:generate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.14"
  }
}
